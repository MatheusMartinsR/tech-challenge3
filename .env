# ---------------------------------------------------------------------------
# Variáveis de ambiente da stack local (docker compose).
#
# ATENÇÃO: os valores abaixo são de DESENVOLVIMENTO e estão versionados de
# propósito, para que a stack suba com um `docker compose up --build` sem etapa
# manual de configuração. Em um projeto real este arquivo ficaria no
# .gitignore e apenas um .env.example seria versionado.
# ---------------------------------------------------------------------------

# --- Banco do Serviço de Agendamento ---
POSTGRES_AGENDAMENTO_DB=techchallenge
POSTGRES_AGENDAMENTO_USER=techchallenge
POSTGRES_AGENDAMENTO_PASSWORD=techchallenge
POSTGRES_AGENDAMENTO_PORT=5432

# --- Banco do Serviço de Notificações ---
# Um banco por serviço: nenhum dos dois lê as tabelas do outro. A porta externa
# é outra apenas para os dois containers conviverem na mesma máquina.
POSTGRES_NOTIFICACAO_DB=techchallenge_notificacao
POSTGRES_NOTIFICACAO_USER=notificacao
POSTGRES_NOTIFICACAO_PASSWORD=notificacao
POSTGRES_NOTIFICACAO_PORT=5433

# --- RabbitMQ (container do broker) ---
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Aplicações ---
# Os nomes das variáveis SPRING_* seguem o binding relaxado do Spring Boot:
# SPRING_DATASOURCE_URL sobrescreve spring.datasource.url, e assim por diante.
# Os hosts usados no compose são os nomes dos serviços, não localhost.
AGENDAMENTO_PORT=8080
NOTIFICACAO_PORT=8081

# --- JWT (só o Serviço de Agendamento usa) ---
JWT_SECRET=dGVjaC1jaGFsbGVuZ2UtMy1kZXYtc2VjcmV0LWtleS1jaGFuZ2UtbWUtaW4tcHJvZHVjdGlvbg==
JWT_EXPIRATION_MS=3600000
