# ---------------------------------------------------------------------------
# Variáveis de ambiente da stack local (docker compose).
#
# ATENÇÃO: os valores abaixo são de DESENVOLVIMENTO e estão versionados de
# propósito, para que a aplicação suba com um `docker compose up` sem etapa
# manual de configuração. Em um projeto real este arquivo ficaria no
# .gitignore e apenas um .env.example seria versionado.
# ---------------------------------------------------------------------------

# --- PostgreSQL (container do banco) ---
POSTGRES_DB=techchallenge
POSTGRES_USER=techchallenge
POSTGRES_PASSWORD=techchallenge
POSTGRES_PORT=5432

# --- RabbitMQ (container do broker) ---
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Aplicação ---
# Os nomes seguem o binding relaxado do Spring Boot: SPRING_DATASOURCE_URL
# sobrescreve spring.datasource.url do application.properties, e assim por diante.
# Os hosts são os nomes dos serviços no compose, não localhost.
APP_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/techchallenge
SPRING_DATASOURCE_USERNAME=techchallenge
SPRING_DATASOURCE_PASSWORD=techchallenge
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# --- JWT ---
JWT_SECRET=dGVjaC1jaGFsbGVuZ2UtMy1kZXYtc2VjcmV0LWtleS1jaGFuZ2UtbWUtaW4tcHJvZHVjdGlvbg==
JWT_EXPIRATION_MS=3600000
