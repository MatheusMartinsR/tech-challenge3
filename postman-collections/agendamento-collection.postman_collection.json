{
    "info":  {
                 "name":  "TechChallenge3 - Scheduling API",
                 "_postman_id":  "agendamento-collection",
                 "description":  "REST and GraphQL requests for the Scheduling Service. Run the Authentication collection first to populate role-specific JWTs and user IDs.",
                 "schema":  "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
             },
    "item":  [
                 {
                     "name":  "REST - Appointment CRUD",
                     "item":  [
                                  {
                                      "name":  "Create appointment (MEDICO or ENFERMEIRO)",
                                      "request":  {
                                                      "method":  "POST",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "value":  "application/json"
                                                                     },
                                                                     {
                                                                         "key":  "Authorization",
                                                                         "value":  "Bearer {{tokenEnfermeiro}}"
                                                                     }
                                                                 ],
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"pacienteId\": {{pacienteId}},\n  \"medicoId\": {{medicoId}},\n  \"dataHora\": \"{{futureDate}}\",\n  \"observacoes\": \"Appointment created from Postman\"\n}"
                                                               },
                                                      "url":  {
                                                                  "raw":  "{{base_url}}/consultas",
                                                                  "host":  [
                                                                               "{{base_url}}"
                                                                           ],
                                                                  "path":  [
                                                                               "consultas"
                                                                           ]
                                                              },
                                                      "description":  "Requires MEDICO or ENFERMEIRO. Expected response: 201 Created."
                                                  },
                                      "event":  [
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "exec":  [
                                                                                    "pm.test(\u0027Created\u0027, () =\u003e pm.response.to.have.status(201));",
                                                                                    "try {",
                                                                                    "  var body = pm.response.json();",
                                                                                    "  if (body \u0026\u0026 body.id) { pm.environment.set(\u0027consultaId\u0027, body.id); }",
                                                                                    "} catch (e) { console.log(\u0027Could not save consultaId:\u0027, e); }"
                                                                                ]
                                                                   }
                                                    }
                                                ]
                                  },
                                  {
                                      "name":  "List appointments",
                                      "request":  {
                                                      "method":  "GET",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Authorization",
                                                                         "value":  "Bearer {{tokenPaciente}}"
                                                                     }
                                                                 ],
                                                      "url":  {
                                                                  "raw":  "{{base_url}}/consultas",
                                                                  "host":  [
                                                                               "{{base_url}}"
                                                                           ],
                                                                  "path":  [
                                                                               "consultas"
                                                                           ]
                                                              },
                                                      "description":  "Staff see all appointments; PACIENTE sees only their own."
                                                  },
                                      "event":  [
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "exec":  [
                                                                                    "pm.test(\u0027Request succeeds\u0027, () =\u003e pm.response.to.have.status(200));"
                                                                                ]
                                                                   }
                                                    }
                                                ]
                                  },
                                  {
                                      "name":  "Get appointment by ID",
                                      "request":  {
                                                      "method":  "GET",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Authorization",
                                                                         "value":  "Bearer {{tokenPaciente}}"
                                                                     }
                                                                 ],
                                                      "url":  {
                                                                  "raw":  "{{base_url}}/consultas/{{consultaId}}",
                                                                  "host":  [
                                                                               "{{base_url}}"
                                                                           ],
                                                                  "path":  [
                                                                               "consultas",
                                                                               "{{consultaId}}"
                                                                           ]
                                                              }
                                                  },
                                      "event":  [
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "exec":  [
                                                                                    "pm.test(\u0027Request succeeds\u0027, () =\u003e pm.response.to.have.status(200));"
                                                                                ]
                                                                   }
                                                    }
                                                ]
                                  },
                                  {
                                      "name":  "Update appointment (MEDICO or ENFERMEIRO)",
                                      "request":  {
                                                      "method":  "PUT",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "value":  "application/json"
                                                                     },
                                                                     {
                                                                         "key":  "Authorization",
                                                                         "value":  "Bearer {{tokenMedico}}"
                                                                     }
                                                                 ],
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"pacienteId\": {{pacienteId}},\n  \"medicoId\": {{medicoId}},\n  \"dataHora\": \"{{futureDate}}\",\n  \"observacoes\": \"Appointment update from Postman\"\n}"
                                                               },
                                                      "url":  {
                                                                  "raw":  "{{base_url}}/consultas/{{consultaId}}",
                                                                  "host":  [
                                                                               "{{base_url}}"
                                                                           ],
                                                                  "path":  [
                                                                               "consultas",
                                                                               "{{consultaId}}"
                                                                           ]
                                                              },
                                                      "description":  "Requires MEDICO or ENFERMEIRO. Expected response: 200 OK."
                                                  },
                                      "event":  [
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "exec":  [
                                                                                    "pm.test(\u0027Request succeeds\u0027, () =\u003e pm.response.to.have.status(200));"
                                                                                ]
                                                                   }
                                                    }
                                                ]
                                  },
                                  {
                                      "name":  "Cancel appointment (MEDICO or ENFERMEIRO)",
                                      "request":  {
                                                      "method":  "DELETE",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Authorization",
                                                                         "value":  "Bearer {{tokenMedico}}"
                                                                     }
                                                                 ],
                                                      "url":  {
                                                                  "raw":  "{{base_url}}/consultas/{{consultaId}}",
                                                                  "host":  [
                                                                               "{{base_url}}"
                                                                           ],
                                                                  "path":  [
                                                                               "consultas",
                                                                               "{{consultaId}}"
                                                                           ]
                                                              },
                                                      "description":  "Logical cancellation. Expected: 200 first, then 409 if repeated."
                                                  },
                                      "event":  [
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "exec":  [
                                                                                    "pm.test(\u0027Request succeeds\u0027, () =\u003e pm.response.to.have.status(200));"
                                                                                ]
                                                                   }
                                                    }
                                                ]
                                  }
                              ]
                 },
                 {
                     "name":  "GraphQL - Appointments and history",
                     "item":  [
                                  {
                                      "name":  "consultasPorPaciente",
                                      "request":  {
                                                      "method":  "POST",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "value":  "application/json"
                                                                     },
                                                                     {
                                                                         "key":  "Authorization",
                                                                         "value":  "Bearer {{tokenPaciente}}"
                                                                     }
                                                                 ],
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"query\": \"query ConsultasPorPaciente($pacienteId: ID!, $status: StatusConsulta) { consultasPorPaciente(pacienteId: $pacienteId, status: $status) { id dataHora status observacoes paciente { id nome } medico { id nome } } }\",\n  \"variables\": {\n    \"pacienteId\": \"{{pacienteId}}\",\n    \"status\": \"AGENDADA\"\n  }\n}"
                                                               },
                                                      "url":  {
                                                                  "raw":  "{{base_url}}/graphql",
                                                                  "host":  [
                                                                               "{{base_url}}"
                                                                           ],
                                                                  "path":  [
                                                                               "graphql"
                                                                           ]
                                                              },
                                                      "description":  "Query GraphQL (Issue #5). Protegida por role: MEDICO, ENFERMEIRO ou PACIENTE autenticado."
                                                  },
                                      "event":  [
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "exec":  [
                                                                                    "pm.test(\u0027GraphQL query succeeds\u0027, () =\u003e { pm.response.to.have.status(200); pm.expect(pm.response.json().errors).to.be.undefined; });"
                                                                                ]
                                                                   }
                                                    }
                                                ]
                                  },
