                                                                           ],
                                                                  "path":  [
                                                                               "graphql"
                                                                           ]
                                                              }
                                                  },
                                      "event":  [
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "exec":  [
                                                                                    "pm.test(\u0027GraphQL query succeeds\u0027, () =\u003e { pm.response.to.have.status(200); pm.expect(pm.response.json().errors).to.be.undefined; });"
                                                                                ]
                                                                   }
                                                    }
                                                ]
                                  },
                                  {
                                      "name":  "consultasFuturas without token (denied)",
                                      "request":  {
                                                      "method":  "POST",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "value":  "application/json"
                                                                     }
                                                                 ],
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"query\": \"query { consultasFuturas(pacienteId: \\\"{{pacienteId}}\\\") { id status } }\"\n}"
                                                               },
                                                      "url":  {
                                                                  "raw":  "{{base_url}}/graphql",
                                                                  "host":  [
                                                                               "{{base_url}}"
                                                                           ],
                                                                  "path":  [
                                                                               "graphql"
                                                                           ]
                                                              },
                                                      "description":  "GraphQL authorization example: HTTP 200 with an errors array."
                                                  },
                                      "event":  [
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "exec":  [
                                                                                    "pm.test(\u0027Unauthenticated GraphQL query is denied\u0027, () =\u003e { pm.response.to.have.status(200); pm.expect(pm.response.json().errors).to.be.an(\u0027array\u0027).that.is.not.empty; });"
                                                                                ]
                                                                   }
                                                    }
                                                ]
                                  }
                              ]
                 },
