                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"query\": \"query HistoricoCompleto($pacienteId: ID!) { historicoCompleto(pacienteId: $pacienteId) { id dataHora status observacoes } }\",\n  \"variables\": {\n    \"pacienteId\": \"{{pacienteId}}\"\n  }\n}"
                                                               },
                                                      "url":  {
                                                                  "raw":  "{{base_url}}/graphql",
                                                                  "host":  [
