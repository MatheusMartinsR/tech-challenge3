# Artefatos de build: a compilação acontece dentro da imagem.
target/
*/target/

# Metadados de VCS e IDE.
.git/
.gitignore
.gitattributes
.idea/
*.iml

# Wrapper do Maven: o estágio de build usa a imagem oficial do Maven.
.mvn/
mvnw
mvnw.cmd

